# BAPC VPN & Digital Security control plane configuration.
# Copy to .env for local development; production must load these from an
# approved secret-management system (never from a checked-in file), and
# `loadConfig` refuses to start in NODE_ENV=production with the default
# development secrets below.

NODE_ENV=development

# --- Control-plane database ---
DATABASE_URL=postgres://bapc:bapc@localhost:5432/bapc_security_core

# --- REST control API (src/runtime/production-server.ts) ---
BIND_HOST=127.0.0.1
PORT=8080
# Must be >=32 chars in production; used to HMAC-sign/verify bearer tokens.
CONTROL_API_TOKEN_SECRET=development-only-change-me
# Must be >=32 chars in production; used to sign outbound ecosystem events.
EVENT_SIGNING_SECRET=development-event-secret-change-me
CERTIFICATE_TTL_MINUTES=1440
KEY_ROTATION_DAYS=30
SAFE_APPLY_TIMEOUT_MS=60000
AUTH_REFRESH_MS=30000
OOB_REQUIRED=true

# --- gRPC mesh orchestration (src/runtime/grpc-server.ts) ---
GRPC_PORT=50051

# --- Secure DNS (src/runtime/dns-server.ts) ---
DNS_BIND_HOST=127.0.0.1
DNS_PORT=53
# One domain per line, '#' comments allowed. Optional — see services/dns/threat-feed.ts.
# DNS_THREAT_FEED_PATH=/etc/bapc-security/dns-threat-feed.txt

# --- Blind relay (src/runtime/relay-server.ts) ---
RELAY_BIND_HOST=0.0.0.0
RELAY_PORT=51900

# --- Egress gateway (src/runtime/egress-server.ts) ---
EGRESS_BIND_HOST=0.0.0.0
EGRESS_PORT=1080
# Comma-separated allowlist entries as "host" or "host:port". Optional — omit to allow all.
# EGRESS_ALLOWLIST=api.example.com,10.0.5.10:443

# --- Out-of-band recovery channel (src/runtime/oob-server.ts) ---
OOB_BIND_HOST=127.0.0.1
OOB_PORT=8181
# Required, >=32 chars, and MUST differ from CONTROL_API_TOKEN_SECRET — this
# channel's entire purpose is to stay reachable if the main control plane's
# credentials or network path are compromised or unavailable.
OOB_SHARED_SECRET=

# --- SOC/admin console static server (src/runtime/admin-console-server.ts) ---
ADMIN_CONSOLE_BIND_HOST=127.0.0.1
ADMIN_CONSOLE_PORT=8090

# --- Endpoint agent (src/runtime/agent.ts) ---
# BAPC_NODE_ID=
# BAPC_CONTROLLER_URL=https://security-control.internal
# BAPC_AGENT_TOKEN=
BAPC_AGENT_VERSION=0.4.0
BAPC_HEARTBEAT_INTERVAL_MS=30000

# --- Backup/restore (scripts/db-backup.sh, scripts/db-restore.sh) ---
# BACKUP_DIR=./backups
# BACKUP_ENCRYPTION_KEY=
