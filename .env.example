# BAPC VPN & Digital Security control plane configuration.
# Copy to .env for local development; production must load these from an
# approved secret-management system (never from a checked-in file), and
# `loadConfig` refuses to start in NODE_ENV=production with the default
# development secrets below.

NODE_ENV=development

# --- AWS Secrets Manager (src/infrastructure/aws-secrets.ts) ---
# Real, wired code — not a stub — gated purely on whether this is set. Every
# runtime entrypoint calls hydrateSecretsFromAws() before reading any secret
# below, so once an AWS account/secret exists, setting this is all it takes
# to stop reading CONTROL_API_TOKEN_SECRET etc. from plain environment
# variables. The secret must be a JSON object whose keys are the exact env
# var names below (e.g. {"CONTROL_API_TOKEN_SECRET":"...","OOB_SHARED_SECRET":"..."}).
# An env var that's already set (e.g. by docker-compose) always wins over the
# secret store. Leave unset for local development — "coming soon" until an
# AWS account exists, not a fake placeholder.
# AWS_SECRETS_MANAGER_SECRET_ID=bapc/prod/control-plane
# AWS_REGION=us-east-1

# --- Control-plane database ---
DATABASE_URL=postgres://bapc:bapc@localhost:5432/bapc_security_core

# --- REST control API (src/runtime/production-server.ts) ---
BIND_HOST=127.0.0.1
PORT=8080
# Must be >=32 chars in production; used to HMAC-sign/verify bearer tokens.
CONTROL_API_TOKEN_SECRET=development-only-change-me
# Must be >=32 chars in production; used to sign outbound ecosystem events.
EVENT_SIGNING_SECRET=development-event-secret-change-me
CERTIFICATE_TTL_MINUTES=1440
KEY_ROTATION_DAYS=30
SAFE_APPLY_TIMEOUT_MS=60000
AUTH_REFRESH_MS=30000
OOB_REQUIRED=true

# Shared HMAC secrets for signed BAPC ecosystem events (integrations/signed-event-client.ts,
# src/application/integrations.ts). Each must be >=32 chars in production and
# match the corresponding sibling app's own secret. DIAGNOSTICS_SHARED_SECRET
# specifically is what signs forensic-clearance tokens for node restore
# (integrations/diagnostics-clearance.ts) — treat it with the same care as
# CONTROL_API_TOKEN_SECRET.
DIAGNOSTICS_SHARED_SECRET=development-diagnostics-secret-change-me
HEADQUARTERS_SHARED_SECRET=development-headquarters-secret-change-me
CLOUD_DEPLOYMENT_SHARED_SECRET=development-cloud-deployment-secret-change-me
INTEGRATION_SHARED_SECRET=development-integration-secret-change-me

# --- gRPC mesh orchestration (src/runtime/grpc-server.ts) ---
GRPC_PORT=50051

# --- AWS KMS-backed trust anchor (services/trust-core/trust-anchor.ts) ---
# Real, wired code — not a stub — gated purely on whether these are set. Both
# production-server.ts (CRL + threat-response certificate issuance) and
# grpc-server.ts (node enrollment) call the same loadTrustAnchor(), which
# uses this AWS KMS key for X.509 signing when present. Leave unset for local
# development: a real, chain-verifiable ephemeral CA is generated and shared
# (via the dev_trust_anchor table) across every process automatically —
# "coming soon" until an AWS account/KMS key exists, not a fake placeholder.
# Requires an asymmetric RSA_3072 or RSA_4096 KMS key (RS256 only — see
# aws-kms-key-provider.ts for why EC keys aren't supported yet) and AWS
# credentials available via the default provider chain (env vars, an
# instance/task role, etc. — never put an access key in this file).
# AWS_KMS_INTERMEDIATE_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AWS_REGION=us-east-1
# TRUST_ANCHOR_SUBJECT=BAPC Intermediate CA 1

# --- Secure DNS (src/runtime/dns-server.ts) ---
DNS_BIND_HOST=127.0.0.1
DNS_PORT=53
# One domain per line, '#' comments allowed. Optional — see services/dns/threat-feed.ts.
# DNS_THREAT_FEED_PATH=/etc/bapc-security/dns-threat-feed.txt

# --- Blind relay (src/runtime/relay-server.ts) ---
RELAY_BIND_HOST=0.0.0.0
RELAY_PORT=51900

# --- Egress gateway (src/runtime/egress-server.ts) ---
EGRESS_BIND_HOST=0.0.0.0
EGRESS_PORT=1080
# Comma-separated allowlist entries as "host" or "host:port". Optional — omit to allow all.
# EGRESS_ALLOWLIST=api.example.com,10.0.5.10:443

# --- Out-of-band recovery channel (src/runtime/oob-server.ts) ---
OOB_BIND_HOST=127.0.0.1
OOB_PORT=8181
# Required, >=32 chars, and MUST differ from CONTROL_API_TOKEN_SECRET — this
# channel's entire purpose is to stay reachable if the main control plane's
# credentials or network path are compromised or unavailable.
OOB_SHARED_SECRET=

# --- SOC/admin console static server (src/runtime/admin-console-server.ts) ---
ADMIN_CONSOLE_BIND_HOST=127.0.0.1
ADMIN_CONSOLE_PORT=8090

# --- Endpoint agent (src/runtime/agent.ts) ---
# BAPC_NODE_ID=
# BAPC_CONTROLLER_URL=https://security-control.internal
# BAPC_AGENT_TOKEN=
BAPC_AGENT_VERSION=0.4.0
BAPC_HEARTBEAT_INTERVAL_MS=30000

# --- Backup/restore (scripts/db-backup.sh, scripts/db-restore.sh) ---
# BACKUP_DIR=./backups
# BACKUP_ENCRYPTION_KEY=
