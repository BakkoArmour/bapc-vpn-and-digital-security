# /etc/bapc-vpn/<instance>.env for the systemd (no Docker) layout: one file per instance (prod, staging), root:bapc-vpn 0640.
# setup-host.sh writes it for staging; cutover.sh writes prod from the Docker deploy/.env, so no secret changes.
# Every service of the instance reads this one file. Ports: prod keeps exactly the ports the tunnel and gateway already use.
# systemd env files allow no comment after a value, so every note is on the line above it.

# --- database (host PostgreSQL 18, loopback only; staging uses bapc_security_staging) ---
DATABASE_URL=postgres://bapc_security:CHANGE_ME@127.0.0.1:5432/bapc_security_core

# --- core secrets (production refuses placeholders and short values; staging has its own) ---
CONTROL_API_TOKEN_SECRET=
EVENT_SIGNING_SECRET=
OOB_SHARED_SECRET=
DIAGNOSTICS_SHARED_SECRET=
HEADQUARTERS_SHARED_SECRET=
CLOUD_DEPLOYMENT_SHARED_SECRET=
INTEGRATION_SHARED_SECRET=
ATTESTATION_PROVIDER=windows-tpm

# --- where each service listens: all loopback; the Cloudflare tunnel reaches the API and the portal ---
BIND_HOST=127.0.0.1
# control API (vpn.bapc-headquarters.com): prod 8080, staging 18080
PORT=8080
PORTAL_BIND_HOST=127.0.0.1
# customer portal (vpn.bapc.app): prod 8095, staging 18095
PORTAL_PORT=8095
# mesh gRPC: prod 50051, staging 60051
GRPC_PORT=50051
OOB_BIND_HOST=127.0.0.1
# out-of-band channel: prod 8181, staging 18181 (and OOB_CONTROLLER_URL to match)
OOB_PORT=8181
OOB_CONTROLLER_URL=http://127.0.0.1:8181
ADMIN_CONSOLE_BIND_HOST=127.0.0.1
# SOC console: prod 8090, staging 18090
ADMIN_CONSOLE_PORT=8090
DNS_BIND_HOST=127.0.0.1
# secure DNS: prod 5353, staging 15353
DNS_PORT=5353
RELAY_BIND_HOST=127.0.0.1
# blind relay: prod 51900, staging 61900
RELAY_PORT=51900
EGRESS_BIND_HOST=127.0.0.1
# egress gateway: prod 1080, staging 11080
EGRESS_PORT=1080

# --- relay and egress self-registration with the control API (same port as PORT above) ---
BAPC_CONTROLLER_URL=http://127.0.0.1:8080
RELAY_ID=0a2e90eb-ff1b-47e7-9224-6c633c21883c
RELAY_REGION=local
RELAY_PUBLIC_ENDPOINT=127.0.0.1:51900
RELAY_AGENT_TOKEN=
EGRESS_ID=c7275156-d439-421d-beab-8d37f12480e3
EGRESS_REGION=local
EGRESS_FIXED_IP=127.0.0.1:1080
EGRESS_AGENT_TOKEN=

# --- VPN gateway: prod only (written by deploy/gateway/setup-gateway.sh); staging leaves these empty ---
VPN_GATEWAY_PUBLIC_KEY=
VPN_GATEWAY_ENDPOINT=
VPN_CLIENT_DNS=1.1.1.1,1.0.0.1

# --- customer portal integrations (see docs/PRODUCTION.md); staging leaves the keys empty ---
PORTAL_PUBLIC_ORIGIN=https://vpn.bapc.app
BAPC_IDENTITY_URL=https://bapc.app
BAPC_CLIENT_SECRET=
BAPC_BILLING_URL=https://billing.bapc.app
BAPC_BILLING_KEY=
BAPC_BILLING_HOOK_SECRET=
BAPC_NOTIFICATIONS_KEY=
WAREHOUSE_URL=https://warehouse.bapc.app
WAREHOUSE_SOURCE_ID=
WAREHOUSE_SIGNING_SECRET=
OBOP_INGEST_TOKEN=
OBOP_SYSTEM_ID=
OBOP_SERVICE_KEY=web
BAPC_RELEASE=
